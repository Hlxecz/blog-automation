{
  "name": "tistory-draft-workflow",
  "private": true,
  "version": "0.8.0",
  "description": "H.Dev Studio - 개발 캡처와 티스토리 글 작업실",
  "author": "H.Dev",
  "main": "desktop/main.mjs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/server.mjs",
    "blog": "node scripts/blog.mjs",
    "test": "node --test",
    "test:desktop": "electron validation/electron-publish.mjs",
    "test:categories": "electron validation/electron-categories.mjs",
    "test:writing": "electron validation/electron-writing-prompts.mjs",
    "test:setup": "electron validation/electron-blog-setup.mjs",
    "test:account": "electron validation/electron-account.mjs",
    "test:refine": "electron validation/electron-refine.mjs",
    "desktop": "electron .",
    "release:check": "node scripts/release.mjs check",
    "release:checksums": "node scripts/release.mjs checksums",
    "build:exe": "node scripts/release.mjs build"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "cheerio": "1.2.0"
  },
  "build": {
    "appId": "com.hdev.studio",
    "productName": "H.Dev Studio",
    "directories": {
      "output": "dist",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/**/*",
      "scripts/**/*",
      "web/**/*",
      "config/**/*",
      "docs/WRITING.md",
      "AGENTS.md",
      "package.json"
    ],
    "asarUnpack": [
      "desktop/publish.mjs"
    ],
    "win": {
      "target": "portable",
      "icon": "desktop/assets/icon.ico"
    },
    "portable": {
      "artifactName": "HDev-Studio-${version}-win-x64.exe"
    }
  }
}
